# ==============================================================================
# 100% FREE ENVIRONMENT CONFIGURATION FOR AI BUSINESS AUTOMATION SAAS
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-saas-jwt-key-change-in-production
DEFAULT_TENANT_ID=tenant_default_demo

# ------------------------------------------------------------------------------
# 1. DATABASE OPTIONS (100% FREE)
# ------------------------------------------------------------------------------
# OPTION A (DEFAULT): Your Local Microsoft SQL Server instance (Running on your PC for $0)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AIBusinessSaaS
DB_USER=saas_user
DB_PASSWORD=StrongPassword!2026
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DATABASE_URL=sqlserver://localhost:1433;database=AIBusinessSaaS;user=saas_user;password=StrongPassword!2026;encrypt=true;trustServerCertificate=true;

# OPTION B: Free Azure SQL Database (100k vCore-seconds/month free on Azure Free Tier)
# DATABASE_URL=sqlserver://your-free-server.database.windows.net:1433;database=AIBusinessSaaS;user=admin;password=Pass!;encrypt=true;

# ------------------------------------------------------------------------------
# 2. AI ENGINE OPTIONS (100% FREE)
# ------------------------------------------------------------------------------
# OPTION A: Built-in Heuristic Engine (Leave OPENAI_API_KEY blank, works 100% offline for $0)
# OPENAI_API_KEY=

# OPTION B: Groq (100% Free ultra-fast API at https://console.groq.com)
# OPENAI_API_KEY=gsk_your_groq_free_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# OPTION C: OpenRouter Free Models (Get free key at https://openrouter.ai/keys)
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-exp:free

# OPTION D: Ollama (100% Free local offline model on your laptop, e.g. 'ollama run llama3')
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3

# OPTION E: OpenAI standard (Optional if you have an OpenAI key)
# OPENAI_API_KEY=sk-proj-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. REDIS CACHE OPTIONS (100% FREE)
# ------------------------------------------------------------------------------
# OPTION A (DEFAULT): Built-in in-memory cache (Leave blank for $0 and zero setup)
REDIS_URL=

# OPTION B: Free Serverless Redis from Upstash (10,000 commands/day free at https://upstash.com)
# REDIS_URL=rediss://default:your-token@your-host.upstash.io:6379
